DATABASE_URL=postgresql://seu_usuario:sua_senha@localhost:5432/agrotech_db
THINGSPEAK_READ_KEY=sua_chave_aqui
THINGSPEAK_CHANNEL_ID=seu_canal_aqui
SECRET_KEY=sua_chave_secreta_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Ingestão automática do ThingSpeak (1º ciclo importa até 8000 leituras; depois busca as últimas 100)
INGEST_ENABLED=true
INGEST_INTERVAL_SECONDS=20
# Origens liberadas no CORS: front-end Vite (dev) e deploy na Vercel
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://front-pi-2026-2-frmjlecdz-vitorrsantoss.vercel.app
# Senha dos usuários criados por `python -m app.seed`
SEED_PASSWORD=barto@2026
# Libera todos os deploys do projeto na Vercel (o endereço muda a cada publicação)
CORS_ORIGIN_REGEX=^https://front-pi-2026-2(-[a-z0-9-]+)?-vitorrsantoss\.vercel\.app$|^https://front-pi-2026-2\.vercel\.app$
# Envio de e-mail para recuperação de senha ("console" imprime link no terminal; "smtp" envia via Gmail)
MAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app_gmail
MAIL_FROM=seu_email@gmail.com
FRONTEND_RESET_URL=http://localhost:5173/reset-password
RATE_LIMIT_ENABLED=true
