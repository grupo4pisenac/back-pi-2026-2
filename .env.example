DATABASE_URL=postgresql://seu_usuario:sua_senha@localhost:5432/agrotech_db
THINGSPEAK_READ_KEY=sua_chave_aqui
THINGSPEAK_CHANNEL_ID=seu_canal_aqui
SECRET_KEY=sua_chave_secreta_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Ingestão automática do ThingSpeak (1º ciclo importa até 8000 leituras; depois busca as últimas 100)
INGEST_ENABLED=true
INGEST_INTERVAL_SECONDS=20
# Origens liberadas no CORS (front-end Vite)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Senha dos usuários criados por `python -m app.seed`
SEED_PASSWORD=barto@2026
